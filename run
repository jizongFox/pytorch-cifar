#!/bin/bash
#
export PYTHONOPTIMIZE=1
base_dir=runs2
python main.py --save-dir ${base_dir}/baseline/lr_0.01 --strategy-name=constant --enable-scale --lr 0.01
python main.py --save-dir ${base_dir}/baseline/lr_0.001 --strategy-name=constant --enable-scale --lr 0.001
python main.py --save-dir ${base_dir}/baseline/lr_0.0001 --strategy-name=constant --enable-scale --lr 0.0001
python main.py --save-dir ${base_dir}/baseline/lr_0.00001 --strategy-name=constant --enable-scale --lr 0.00001

python main.py --save-dir ${base_dir}/stochastic/T_10.0 --strategy-name=stochastic --enable-scale --lr 0.01 --possible-lrs 0.001 0.0001 0.00001 --T 10.0
python main.py --save-dir ${base_dir}/stochastic/T_1.0 --strategy-name=stochastic --enable-scale --lr 0.01 --possible-lrs 0.001 0.0001 0.00001 --T 1.0
python main.py --save-dir ${base_dir}/stochastic/T_0.1 --strategy-name=stochastic --enable-scale --lr 0.01 --possible-lrs 0.001 0.0001 0.00001 --T 0.1
python main.py --save-dir ${base_dir}/stochastic/T_0.05 --strategy-name=stochastic --enable-scale --lr 0.01 --possible-lrs 0.001 0.0001 0.00001 --T 0.05
python main.py --save-dir ${base_dir}/stochastic/T_0.01 --strategy-name=stochastic --enable-scale --lr 0.01 --possible-lrs 0.001 0.0001 0.00001 --T 0.01
