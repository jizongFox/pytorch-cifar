#!/bin/bash
#
export PYTHONOPTIMIZE=1

update_step=1
base_dir=runs_step_update_${update_step}

python main.py --save-dir ${base_dir}/baseline/lr_0.01 --strategy-name=constant --enable-scale --lr 0.01
python main.py --save-dir ${base_dir}/baseline/lr_0.001 --strategy-name=constant --enable-scale --lr 0.001
python main.py --save-dir ${base_dir}/baseline/lr_0.0001 --strategy-name=constant --enable-scale --lr 0.0001
python main.py --save-dir ${base_dir}/baseline/lr_0.00001 --strategy-name=constant --enable-scale --lr 0.00001

python main.py --save-dir ${base_dir}/stochastic/T_10.0 --strategy-name=stochastic --enable-scale --lr 0.01 --possible-lrs 0.001 0.0001 0.00001 --T 10.0 --N ${update_step}
python main.py --save-dir ${base_dir}/stochastic/T_1.0 --strategy-name=stochastic --enable-scale --lr 0.01 --possible-lrs 0.001 0.0001 0.00001 --T 1.0 --N ${update_step}
python main.py --save-dir ${base_dir}/stochastic/T_0.1 --strategy-name=stochastic --enable-scale --lr 0.01 --possible-lrs 0.001 0.0001 0.00001 --T 0.1 --N ${update_step}
python main.py --save-dir ${base_dir}/stochastic/T_0.05 --strategy-name=stochastic --enable-scale --lr 0.01 --possible-lrs 0.001 0.0001 0.00001 --T 0.05 --N ${update_step}
python main.py --save-dir ${base_dir}/stochastic/T_0.04 --strategy-name=stochastic --enable-scale --lr 0.01 --possible-lrs 0.001 0.0001 0.00001 --T 0.04 --N ${update_step}
python main.py --save-dir ${base_dir}/stochastic/T_0.03 --strategy-name=stochastic --enable-scale --lr 0.01 --possible-lrs 0.001 0.0001 0.00001 --T 0.03 --N ${update_step}
python main.py --save-dir ${base_dir}/stochastic/T_0.02 --strategy-name=stochastic --enable-scale --lr 0.01 --possible-lrs 0.001 0.0001 0.00001 --T 0.02 --N ${update_step}
python main.py --save-dir ${base_dir}/stochastic/T_0.01 --strategy-name=stochastic --enable-scale --lr 0.01 --possible-lrs 0.001 0.0001 0.00001 --T 0.01 --N ${update_step}
